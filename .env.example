# ─── Smartmove Marbella — environment variables ───
# Copy to .env.local and fill in. Never commit real values.
# Vercel: set these in Project → Settings → Environment Variables.

# ─── Public site URL ───────────────────────────────────────────
# Used as the canonical base in metadata, sitemaps, and OG tags.
# Vercel preview URL is fine until the real domain is wired.
NEXT_PUBLIC_SITE_URL=https://smartmove-new.vercel.app

# ─── Supabase ──────────────────────────────────────────────────
# From the new Smartmove Supabase project (NOT Marbella Live's).
# Server-only service role key powers admin server actions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resales Online API (via Cloudflare Worker proxy) ──────────
# The Worker holds p1 + p2 + sandbox toggle. The app never sees them.
# Deploy workers/resales-proxy/ first, then paste its URL here.
RESALES_PROXY_URL=https://smartmove-resales-proxy.<account>.workers.dev
# Shared secret sent in `x-smartmove-secret` header. Must match the
# RESALES_PROXY_SECRET wrangler secret on the Worker side.
RESALES_PROXY_SECRET=

# ─── Cloudflare image pipeline ────────────────────────────────
# The image-proxy Worker URL (publicly fetched by next/image).
# Empty in dev = picsum fallback (see SMARTMOVE_BRIEF §8).
NEXT_PUBLIC_IMAGE_PROXY_URL=

# Server-only: needed by purgeImages() during the cleanse job.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ─── Monday CRM (DESIGNED-BUT-DISABLED at launch) ──────────────
# LEAVE EMPTY until the user explicitly says to connect (see
# SMARTMOVE_BRIEF §4.5). With these unset, the wrapper no-ops cleanly.
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
MONDAY_GROUP_ID=

# ─── Resales sync security ─────────────────────────────────────
# Shared secret protecting /api/admin/resales/sync against unauth callers.
# Vercel Cron + manual admin button send this in `x-smartmove-cron-secret`.
SYNC_CRON_SECRET=

# ─── Analytics (consent-gated; CookieBanner reads these) ───────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_PIXEL_ID=
