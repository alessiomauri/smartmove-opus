# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Supabase local secrets and CLI temp state
.supabase-db-password.local
supabase/.temp/
supabase/.branches/

# mcp config (contains access tokens)
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wrangler local secrets / build output
workers/*/.dev.vars
workers/*/dist
workers/*/.wrangler

# worker-specific node_modules
workers/*/node_modules
.resales-proxy-secret.local
.sync-cron-secret.local
Area photos copy/
Area photos/
